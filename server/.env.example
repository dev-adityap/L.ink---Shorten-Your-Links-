# Server
PORT=5000
NODE_ENV=development

# Public base URL for generated short links (no trailing slash)
# In production on Render, set to your service URL (e.g. https://your-service.onrender.com)
# RENDER_EXTERNAL_URL is also used as a fallback if BASE_URL is not set.
BASE_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/url-shortener

# CORS - comma-separated allowed frontend origins (no trailing slash)
# Include local dev and your deployed Vercel URL(s)
CORS_ORIGIN=http://localhost:5173
# Optional alias also supported:
# FRONTEND_URL=https://your-app.vercel.app

# Firebase Admin (service account) - required for authenticated API routes
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Private key: keep \n escapes or wrap in quotes as shown
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
